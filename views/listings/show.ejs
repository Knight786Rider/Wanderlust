<% layout("/layouts/boilerplate") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
  const locationName = "<%= listing.location %>";
</script>

<div class="container my-5 listing-container" style="max-width:960px;">

  <div class="row justify-content-center">
    <div class="col-lg-10">

      <!-- Listing Card -->
      <div class="card mb-4 shadow-sm border-0">

        <img
          src="<%= listing.image && listing.image.url
                  ? listing.image.url
                  : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?auto=format&fit=crop&w=800&q=60' %>"
          class="card-img-top"
          style="height:420px; object-fit:cover;"
        >

        <div class="card-body p-4">

          <h3 class="mb-2"><%= listing.title %></h3>

          <p class="text-muted mb-3">
            <% if (listing.owner) { %>
              <i>Owned by <%= listing.owner.username %></i>
            <% } else { %>
              <i><em>Owner not available</em></i>
            <% } %>
          </p>

          <p class="text-muted mb-3"><%= listing.description %></p>

          <p class="fw-bold mb-1">₹<%= listing.price.toLocaleString("en-IN") %> night</p>
          <p class="text-secondary">
            <i class="fa-solid fa-location-dot me-2"></i>
            <%= listing.location %>, <%= listing.country %>
          </p>

        </div>

      </div>


      <!-- Owner Options -->
      <% if (currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>

      <div class="d-flex gap-3 mb-5">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark px-4">Edit</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
          <button class="btn btn-dark px-4">Delete</button>
        </form>
      </div>

      <% } %>


      <!-- Review Form -->
      <section class="review-form mb-5">

        <h4 class="fw-bold mb-3">Leave a Review</h4>

        <% if (currentUser) { %>

        <form method="POST" action="/listings/<%= listing._id %>/reviews">

          <div class="mb-3">
            <label class="form-label">Rating</label>
            <fieldset class="starability-slot">

              <input type="radio" name="review[rating]" value="1" id="rate1">
              <label for="rate1">1 star</label>

              <input type="radio" name="review[rating]" value="2" id="rate2">
              <label for="rate2">2 stars</label>

              <input type="radio" name="review[rating]" value="3" id="rate3">
              <label for="rate3">3 stars</label>

              <input type="radio" name="review[rating]" value="4" id="rate4">
              <label for="rate4">4 stars</label>

              <input type="radio" name="review[rating]" value="5" id="rate5">
              <label for="rate5">5 stars</label>

            </fieldset>
          </div>

          <div class="mb-3">
            <label class="form-label">Comments</label>
            <textarea
              name="review[comment]"
              class="form-control"
              rows="4"
              required
            ></textarea>
          </div>

          <button class="btn btn-outline-dark px-4">Submit</button>

        </form>

        <% } else { %>

        <p class="text-muted mt-3">
          <em>You must <a href="/login">log in</a> to leave a review.</em>
        </p>

        <% } %>

      </section>



      <!-- Reviews Section -->
      <% if (listing.reviews.length > 0) { %>

      <section class="mb-5">

        <h4 class="fw-bold mb-4">All Reviews</h4>

        <div class="row">

          <% for (let review of listing.reviews) { %>

          <div class="col-md-6 mb-4">

            <div class="card border-0 shadow-sm">
              <div class="card-body">

                <h5 class="fw-semibold mb-2 text-primary">
                  <%= review.author ? review.author.username : "Unknown User" %>
                </h5>

                <p class="text-muted mb-2"><%= review.comment %></p>

                <p class="starability-result" data-rating="<%= review.rating %>">
                  Rated: <%= review.rating %> stars
                </p>

                <% if (currentUser && review.author && currentUser._id.equals(review.author._id)) { %>
                <form
                  method="POST"
                  action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                  class="mt-2"
                >
                  <button class="btn-delete-review">Delete</button>
                </form>
                <% } %>

              </div>
            </div>

          </div>

          <% } %>

        </div>

      </section>

      <% } %>



      <!-- Map -->
      <section>
        <h3 class="fw-bold mb-3">Where you'll be</h3>
        <div id="map" style="height:480px; border-radius:12px; overflow:hidden;"></div>
      </section>

    </div>
  </div>

</div>

<script src="/js/map.js"></script>
